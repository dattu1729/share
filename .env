# Server configuration
MCP_REGISTRY_SERVER_ADDRESS=:8080
MCP_REGISTRY_VERSION=dev

# Seed data - leave empty to skip seeding and start immediately
# To seed from the live registry (slow, may take 1-2 min): https://registry.modelcontextprotocol.io/v0/servers
# To seed from a local file: data/seed.json
MCP_REGISTRY_SEED_FROM=data/seed-import.json

# GitHub OAuth (dev credentials from upstream repo — safe for local use only)
MCP_REGISTRY_GITHUB_CLIENT_ID=
MCP_REGISTRY_GITHUB_CLIENT_SECRET=

# JWT private key (Ed25519 seed — regenerate for any non-local use)
# Generate a new one: openssl rand -hex 32
MCP_REGISTRY_JWT_PRIVATE_KEY=bb2c6b424005acd5df47a9e2c87f446def86dd740c888ea3efb825b23f7ef47c

# Allow anonymous publishing to io.modelcontextprotocol.anonymous/* (dev only)
MCP_REGISTRY_ENABLE_ANONYMOUS_AUTH=false

# Disable upstream validation for local/offline dev
MCP_REGISTRY_ENABLE_REGISTRY_VALIDATION=false

# OIDC (disabled by default)
MCP_REGISTRY_OIDC_ENABLED=false
