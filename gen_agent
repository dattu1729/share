from typing import Dict, List, Any, Optional
from dataclasses import dataclass, field
from enum import Enum
import json
from langchain.schema import BaseMessage, HumanMessage, SystemMessage
from langchain.chat_models import ChatOpenAI
from langgraph.graph import Graph, END
from langgraph.checkpoint.memory import MemorySaver
import logging

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class ComplianceStatus(Enum):
    COMPLIANT = "compliant"
    NON_COMPLIANT = "non_compliant"
    NEEDS_REVIEW = "needs_review"
    INSUFFICIENT_INFO = "insufficient_info"

@dataclass
class ComplianceContext:
    """Represents compliance requirements and rules"""
    framework: str  # e.g., "SOC2", "GDPR", "HIPAA", "PCI-DSS"
    requirements: List[str]
    rules: List[str]
    critical_controls: List[str]
    exceptions: List[str] = field(default_factory=list)

@dataclass
class ComplianceScenario:
    """Represents a scenario to be evaluated"""
    id: str
    description: str
    system_components: List[str]
    data_types: List[str]
    processes: List[str]
    controls_in_place: List[str]
    metadata: Dict[str, Any] = field(default_factory=dict)

@dataclass
class ComplianceResult:
    """Represents the compliance evaluation result"""
    scenario_id: str
    status: ComplianceStatus
    confidence_score: float
    violations: List[str]
    recommendations: List[str]
    compliant_controls: List[str]
    risk_level: str
    detailed_analysis: str

@dataclass
class AgentState:
    """State object for the LangGraph agent"""
    scenario: Optional[ComplianceScenario] = None
    context: Optional[ComplianceContext] = None
    parsed_scenario: Dict[str, Any] = field(default_factory=dict)
    identified_risks: List[str] = field(default_factory=list)
    control_gaps: List[str] = field(default_factory=list)
    compliance_mappings: Dict[str, str] = field(default_factory=dict)
    result: Optional[ComplianceResult] = None
    messages: List[BaseMessage] = field(default_factory=list)

class SecurityComplianceAgent:
    def __init__(self, llm_model: str = "gpt-4", temperature: float = 0.1):
        """Initialize the Security Compliance Agent"""
        self.llm = ChatOpenAI(model=llm_model, temperature=temperature)
        self.memory = MemorySaver()
        self.graph = self._build_graph()
        
    def _build_graph(self) -> Graph:
        """Build the LangGraph workflow"""
        workflow = Graph()
        
        # Define nodes
        workflow.add_node("parse_scenario", self._parse_scenario)
        workflow.add_node("identify_risks", self._identify_risks)
        workflow.add_node("map_controls", self._map_controls)
        workflow.add_node("evaluate_compliance", self._evaluate_compliance)
        workflow.add_node("generate_recommendations", self._generate_recommendations)
        workflow.add_node("finalize_result", self._finalize_result)
        
        # Define edges
        workflow.add_edge("parse_scenario", "identify_risks")
        workflow.add_edge("identify_risks", "map_controls")
        workflow.add_edge("map_controls", "evaluate_compliance")
        workflow.add_edge("evaluate_compliance", "generate_recommendations")
        workflow.add_edge("generate_recommendations", "finalize_result")
        workflow.add_edge("finalize_result", END)
        
        # Set entry point
        workflow.set_entry_point("parse_scenario")
        
        return workflow.compile(checkpointer=self.memory)
    
    def _parse_scenario(self, state: AgentState) -> Dict[str, Any]:
        """Parse and extract key elements from the scenario"""
        logger.info("Parsing scenario...")
        
        prompt = f"""
        As a security compliance expert, analyze the following scenario and extract key elements:
        
        Scenario: {state.scenario.description}
        Components: {state.scenario.system_components}
        Data Types: {state.scenario.data_types}
        Processes: {state.scenario.processes}
        Controls: {state.scenario.controls_in_place}
        
        Extract and categorize:
        1. Security-relevant assets
        2. Data processing activities
        3. Access control mechanisms
        4. Technical safeguards
        5. Administrative controls
        
        Return your analysis in a structured format.
        """
        
        messages = [SystemMessage(content=prompt)]
        response = self.llm.invoke(messages)
        
        # Parse the response (simplified - in practice, you'd use structured output)
        parsed_data = {
            "assets": state.scenario.system_components,
            "data_processing": state.scenario.processes,
            "access_controls": [control for control in state.scenario.controls_in_place if "access" in control.lower()],
            "technical_safeguards": [control for control in state.scenario.controls_in_place if any(tech in control.lower() for tech in ["encryption", "firewall", "monitoring"])],
            "administrative_controls": [control for control in state.scenario.controls_in_place if "policy" in control.lower() or "training" in control.lower()]
        }
        
        return {
            **state.__dict__,
            "parsed_scenario": parsed_data,
            "messages": state.messages + [response]
        }
    
    def _identify_risks(self, state: AgentState) -> Dict[str, Any]:
        """Identify potential security risks in the scenario"""
        logger.info("Identifying risks...")
        
        prompt = f"""
        Based on the parsed scenario and compliance framework {state.context.framework}, 
        identify potential security risks and vulnerabilities:
        
        Parsed Scenario: {json.dumps(state.parsed_scenario, indent=2)}
        Framework Requirements: {state.context.requirements}
        Critical Controls: {state.context.critical_controls}
        
        Identify:
        1. Missing critical controls
        2. Potential data exposure risks
        3. Access control weaknesses
        4. Compliance gaps
        5. Technical vulnerabilities
        
        Provide a risk assessment with severity levels.
        """
        
        messages = [SystemMessage(content=prompt)]
        response = self.llm.invoke(messages)
        
        # Simplified risk identification (in practice, use structured output)
        identified_risks = [
            risk for requirement in state.context.requirements
            if not any(control in requirement.lower() for control in [c.lower() for c in state.scenario.controls_in_place])
        ]
        
        return {
            **state.__dict__,
            "identified_risks": identified_risks,
            "messages": state.messages + [response]
        }
    
    def _map_controls(self, state: AgentState) -> Dict[str, Any]:
        """Map existing controls to compliance requirements"""
        logger.info("Mapping controls to requirements...")
        
        prompt = f"""
        Map the existing controls to the compliance requirements:
        
        Existing Controls: {state.scenario.controls_in_place}
        Framework: {state.context.framework}
        Requirements: {state.context.requirements}
        Rules: {state.context.rules}
        
        Create a mapping showing:
        1. Which requirements are satisfied by existing controls
        2. Which requirements have gaps
        3. Control effectiveness assessment
        4. Redundancy analysis
        
        Provide detailed mapping with justifications.
        """
        
        messages = [SystemMessage(content=prompt)]
        response = self.llm.invoke(messages)
        
        # Create control mappings
        control_mappings = {}
        for control in state.scenario.controls_in_place:
            matching_requirements = [req for req in state.context.requirements if any(keyword in req.lower() for keyword in control.lower().split())]
            control_mappings[control] = matching_requirements
        
        return {
            **state.__dict__,
            "compliance_mappings": control_mappings,
            "messages": state.messages + [response]
        }
    
    def _evaluate_compliance(self, state: AgentState) -> Dict[str, Any]:
        """Evaluate overall compliance status"""
        logger.info("Evaluating compliance...")
        
        prompt = f"""
        Evaluate the compliance status based on:
        
        Framework: {state.context.framework}
        Requirements: {state.context.requirements}
        Critical Controls: {state.context.critical_controls}
        Identified Risks: {state.identified_risks}
        Control Mappings: {json.dumps(state.compliance_mappings, indent=2)}
        
        Determine:
        1. Overall compliance status (compliant/non_compliant/needs_review/insufficient_info)
        2. Confidence level (0-1)
        3. Specific violations
        4. Risk level (low/medium/high/critical)
        5. Compliant controls
        
        Provide detailed justification for the assessment.
        """
        
        messages = [SystemMessage(content=prompt)]
        response = self.llm.invoke(messages)
        
        # Simplified compliance evaluation logic
        critical_controls_met = sum(1 for control in state.context.critical_controls 
                                  if any(existing in control.lower() for existing in [c.lower() for c in state.scenario.controls_in_place]))
        
        total_critical = len(state.context.critical_controls)
        compliance_ratio = critical_controls_met / total_critical if total_critical > 0 else 0
        
        if compliance_ratio >= 0.9:
            status = ComplianceStatus.COMPLIANT
            confidence = 0.9
        elif compliance_ratio >= 0.7:
            status = ComplianceStatus.NEEDS_REVIEW
            confidence = 0.7
        else:
            status = ComplianceStatus.NON_COMPLIANT
            confidence = 0.8
        
        violations = [req for req in state.context.requirements if req in state.identified_risks]
        
        return {
            **state.__dict__,
            "compliance_status": status,
            "confidence_score": confidence,
            "violations": violations,
            "messages": state.messages + [response]
        }
    
    def _generate_recommendations(self, state: AgentState) -> Dict[str, Any]:
        """Generate remediation recommendations"""
        logger.info("Generating recommendations...")
        
        prompt = f"""
        Generate specific, actionable recommendations to address compliance gaps:
        
        Current Status: {state.compliance_status.value}
        Violations: {state.violations}
        Control Gaps: {state.control_gaps}
        Framework: {state.context.framework}
        
        Provide:
        1. Immediate action items
        2. Short-term improvements
        3. Long-term strategic recommendations
        4. Implementation priorities
        5. Resource requirements
        
        Make recommendations specific and actionable.
        """
        
        messages = [SystemMessage(content=prompt)]
        response = self.llm.invoke(messages)
        
        # Generate basic recommendations
        recommendations = []
        for violation in state.violations:
            recommendations.append(f"Address compliance gap: {violation}")
        
        if state.compliance_status == ComplianceStatus.NON_COMPLIANT:
            recommendations.append("Conduct comprehensive security assessment")
            recommendations.append("Implement missing critical controls")
        
        return {
            **state.__dict__,
            "recommendations": recommendations,
            "messages": state.messages + [response]
        }
    
    def _finalize_result(self, state: AgentState) -> Dict[str, Any]:
        """Finalize and structure the compliance result"""
        logger.info("Finalizing result...")
        
        compliant_controls = [control for control, mappings in state.compliance_mappings.items() if mappings]
        
        risk_level = "high" if state.compliance_status == ComplianceStatus.NON_COMPLIANT else \
                    "medium" if state.compliance_status == ComplianceStatus.NEEDS_REVIEW else "low"
        
        result = ComplianceResult(
            scenario_id=state.scenario.id,
            status=state.compliance_status,
            confidence_score=state.confidence_score,
            violations=state.violations,
            recommendations=state.recommendations,
            compliant_controls=compliant_controls,
            risk_level=risk_level,
            detailed_analysis=f"Compliance assessment for {state.context.framework} framework completed."
        )
        
        return {
            **state.__dict__,
            "result": result
        }
    
    def evaluate_scenario(self, scenario: ComplianceScenario, context: ComplianceContext) -> ComplianceResult:
        """Main method to evaluate a scenario for compliance"""
        logger.info(f"Starting compliance evaluation for scenario: {scenario.id}")
        
        # Create initial state
        initial_state = AgentState(scenario=scenario, context=context)
        
        # Run the graph
        config = {"configurable": {"thread_id": f"compliance_{scenario.id}"}}
        final_state = self.graph.invoke(initial_state.__dict__, config=config)
        
        return final_state["result"]

