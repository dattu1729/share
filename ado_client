from azure.devops.connection import Connection
from msrest.authentication import BasicAuthentication
from azure.devops.v7_0.work_item_tracking.models import Wiql
import json
import ssl
import urllib3
import os

class AzureDevOpsWorkItemClient:
    def __init__(self, organization_url, personal_access_token, verify_ssl=True, ca_bundle=None):
        """
        Initialize the Azure DevOps client with SSL options
        
        Args:
            organization_url (str): Your Azure DevOps organization URL 
                                   (e.g., 'https://dev.azure.com/yourorg')
            personal_access_token (str): Your PAT token
            verify_ssl (bool): Whether to verify SSL certificates (default: True)
            ca_bundle (str): Path to CA bundle file (optional)
        """
        # Handle SSL verification settings
        if not verify_ssl:
            # Disable SSL warnings when verification is disabled
            urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
            
            # Create unverified SSL context
            ssl_context = ssl.create_default_context()
            ssl_context.check_hostname = False
            ssl_context.verify_mode = ssl.CERT_NONE
            
            # Set environment variable to disable SSL verification
            os.environ['PYTHONHTTPSVERIFY'] = '0'
            
        elif ca_bundle:
            # Use custom CA bundle
            ssl_context = ssl.create_default_context(cafile=ca_bundle)
            os.environ['REQUESTS_CA_BUNDLE'] = ca_bundle
            os.environ['SSL_CERT_FILE'] = ca_bundle
        else:
            # Use default SSL context
            ssl_context = ssl.create_default_context()
        
        # Store SSL settings for connection
        self.verify_ssl = verify_ssl
        self.ca_bundle = ca_bundle
        
        credentials = BasicAuthentication('', personal_access_token)
        
        # Create connection with SSL settings
        self.connection = Connection(
            base_url=organization_url, 
            creds=credentials
        )
        
        # Configure the underlying HTTP adapter if needed
        if not verify_ssl:
            # Monkey patch the session to ignore SSL
            import requests.adapters
            original_send = requests.adapters.HTTPAdapter.send
            
            def patched_send(self, request, **kwargs):
                kwargs['verify'] = False
                return original_send(self, request, **kwargs)
            
            requests.adapters.HTTPAdapter.send = patched_send
        
        elif ca_bundle:
            # Set CA bundle for requests
            import requests.adapters
            original_send = requests.adapters.HTTPAdapter.send
            
            def patched_send(self, request, **kwargs):
                kwargs['verify'] = ca_bundle
                return original_send(self, request, **kwargs)
            
            requests.adapters.HTTPAdapter.send = patched_send
        
        self.work_item_client = self.connection.clients.get_work_item_tracking_client()
    
    def get_work_item_by_id(self, work_item_id, expand=None):
        """
        Get work item details by ID
        
        Args:
            work_item_id (int): Work item ID
            expand (str): Optional expansion ('relations', 'fields', 'links', 'all')
        
        Returns:
            Work item object
        """
        try:
            work_item = self.work_item_client.get_work_item(
                id=work_item_id,
                expand=expand
            )
            return work_item
        except Exception as e:
            print(f"Error getting work item {work_item_id}: {str(e)}")
            return None
    
    def get_work_items_by_ids(self, work_item_ids, fields=None, expand=None):
        """
        Get multiple work items by their IDs
        
        Args:
            work_item_ids (list): List of work item IDs
            fields (list): Optional list of specific fields to retrieve
            expand (str): Optional expansion
        
        Returns:
            List of work item objects
        """
        try:
            work_items = self.work_item_client.get_work_items(
                ids=work_item_ids,
                fields=fields,
                expand=expand
            )
            return work_items
        except Exception as e:
            print(f"Error getting work items: {str(e)}")
            return []
    
    def query_work_items(self, project, wiql_query):
        """
        Query work items using WIQL (Work Item Query Language)
        
        Args:
            project (str): Project name
            wiql_query (str): WIQL query string
        
        Returns:
            Query results with work items
        """
        try:
            wiql = Wiql(query=wiql_query)
            query_results = self.work_item_client.query_by_wiql(wiql, project=project)
            
            if query_results.work_items:
                # Extract work item IDs from query results
                work_item_ids = [item.id for item in query_results.work_items]
                # Get full work item details
                work_items = self.get_work_items_by_ids(work_item_ids)
                return work_items
            return []
        except Exception as e:
            print(f"Error querying work items: {str(e)}")
            return []
    
    def print_work_item_details(self, work_item):
        """
        Print formatted work item details
        
        Args:
            work_item: Work item object
        """
        if not work_item:
            print("Work item not found")
            return
        
        print(f"Work Item ID: {work_item.id}")
        print(f"URL: {work_item.url}")
        print(f"Revision: {work_item.rev}")
        print("\nFields:")
        
        # Common fields to display
        common_fields = [
            'System.WorkItemType',
            'System.Title',
            'System.State',
            'System.AssignedTo',
            'System.CreatedBy',
            'System.CreatedDate',
            'System.ChangedDate',
            'System.Description',
            'System.Tags',
            'Microsoft.VSTS.Common.Priority',
            'Microsoft.VSTS.Common.Severity'
        ]
        
        for field in common_fields:
            if field in work_item.fields:
                value = work_item.fields[field]
                if isinstance(value, dict) and 'displayName' in value:
                    value = value['displayName']
                print(f"  {field}: {value}")
        
        # Show relations if they exist
        if hasattr(work_item, 'relations') and work_item.relations:
            print("\nRelations:")
            for relation in work_item.relations:
                print(f"  {relation.rel}: {relation.url}")

