# Additional helper function to configure SSL globally
def configure_ssl_globally(verify_ssl=True, ca_bundle=None):
    """
    Configure SSL settings globally for all requests
    
    Args:
        verify_ssl (bool): Whether to verify SSL certificates
        ca_bundle (str): Path to CA bundle file
    """
    if not verify_ssl:
        # Disable SSL warnings
        urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
        
        # Set environment variables
        os.environ['PYTHONHTTPSVERIFY'] = '0'
        os.environ['CURL_CA_BUNDLE'] = ''
        
        # Configure requests to ignore SSL
        import requests
        requests.packages.urllib3.disable_warnings()
        
    elif ca_bundle:
        # Set CA bundle environment variables
        os.environ['REQUESTS_CA_BUNDLE'] = ca_bundle
        os.environ['SSL_CERT_FILE'] = ca_bundle
        os.environ['CURL_CA_BUNDLE'] = ca_bundle

